generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String @id @default(cuid())
  clerkUserId String @unique
  email       String @unique

  firstName String?
  lastName  String?
  imageUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes Resume[]

  @@map("users")
}

model Resume {
  id String @id @default(cuid())

  userId String

  originalFileName String
  cloudinaryUrl    String
  cloudinaryId     String

  parsedData    Json?
  parserVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  embeddings ResumeEmbedding[]

  @@map("resumes")
}

model ResumeEmbedding {
  id String @id @default(cuid())

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  chunkType    ChunkType
  chunkIndex   Int
  chunkContent String

  // pgvector column (3072 dimensions for Gemini embeddings)
  embedding Unsupported("vector(3072)")

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@index([chunkType])
  @@unique([resumeId, chunkIndex])

  @@map("resume_embeddings")
}

model RawJob {
  id String @id @default(cuid())

  // Original job URL
  jobUrl String @unique

  // Original platform information
  platform      String?
  platformJobId String?

  // Hiring company
  companyName    String
  companyWebsite String?
  companyLogoUrl String?

  // Job title
  jobTitle String

  // Original scraped content
  rawHtml String?
  rawText String
  rawJson Json?

  // Raw location exactly as scraped
  location String?

  // Processing status
  status RawJobStatus @default(PENDING)

  parserVersion String?

  processedAt DateTime?

  failureReason String?

  // Duplicate detection
  contentHash String @unique

  // Additional scraper metadata
  metadata Json?

  // When scraper found the job
  scrapedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
  @@index([jobTitle])
  @@index([status])
  @@index([scrapedAt])

  @@map("raw_jobs")
}

enum ChunkType {
  SUMMARY
  SKILLS
  EXPERIENCE
  PROJECT
  EDUCATION
  CERTIFICATION
  ACHIEVEMENT
  LANGUAGE
}

enum RawJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
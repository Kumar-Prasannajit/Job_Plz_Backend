generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  RECRUITER
  ADMIN
}

model User {
  id          String @id @default(cuid())
  clerkUserId String @unique
  email       String @unique

  firstName String?
  lastName  String?
  imageUrl  String?

  role UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes Resume[]

  @@map("users")
}

model Resume {
  id String @id @default(cuid())

  userId String

  originalFileName String
  cloudinaryUrl    String
  cloudinaryId     String

  parsedData    Json?
  parserVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  embeddings ResumeEmbedding[]

  @@map("resumes")
}

model ResumeEmbedding {
  id String @id @default(cuid())

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  chunkType    ChunkType
  chunkIndex   Int
  chunkContent String

  embedding Unsupported("vector(3072)")

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resumeId, chunkIndex])
  @@index([resumeId])
  @@index([chunkType])
  @@map("resume_embeddings")
}

model RawJob {
  id String @id @default(cuid())

  jobUrl String @unique

  platform      String?
  platformJobId String?

  companyName    String
  companyWebsite String?
  companyLogoUrl String?

  jobTitle String

  rawHtml String?
  rawText String
  rawJson Json?

  location String?

  status RawJobStatus @default(PENDING)

  parserVersion String?

  processedAt DateTime?

  failureReason String?

  contentHash String @unique

  metadata Json?

  scrapedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job?

  @@index([companyName])
  @@index([jobTitle])
  @@index([status])
  @@index([scrapedAt])
  @@map("raw_jobs")
}

model Job {
  id String @id @default(cuid())

  rawJobId String @unique

  rawJob RawJob @relation(fields: [rawJobId], references: [id], onDelete: Cascade)

  canonicalData Json

  schemaVersion String

  embeddings JobEmbedding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schemaVersion])
  @@map("jobs")
}

model JobEmbedding {
  id String @id @default(cuid())

  jobId String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  chunkType JobChunkType

  chunkIndex Int

  chunkContent String

  embedding Unsupported("vector(3072)")

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, chunkIndex])
  @@index([jobId])
  @@index([chunkType])
  @@map("job_embeddings")
}

enum ChunkType {
  SUMMARY
  SKILLS
  EXPERIENCE
  PROJECT
  EDUCATION
  CERTIFICATION
  ACHIEVEMENT
  LANGUAGE
}

enum JobChunkType {
  JOB_SUMMARY
  REQUIREMENTS
  SKILLS
  RESPONSIBILITIES
}

enum RawJobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

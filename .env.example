# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL with the pgvector extension available)
# Matches the Docker command in the README; change it if your Postgres differs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_plz

# Clerk (https://dashboard.clerk.com → your app → API keys)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Signing secret (starts with whsec_) from Clerk → Webhooks → your endpoint
CLERK_WEBHOOK_SECRET=

# Cloudinary (https://console.cloudinary.com → Dashboard → API keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (resume extraction only — not used for embeddings)
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.6-flash

# Ollama (embeddings — resumes and jobs both use this)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Redis (single connection URL — used by BullMQ)
REDIS_URL=redis://localhost:6379

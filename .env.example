# Server
PORT=8000
NODE_ENV=development

# Database
DATABASE_URL=

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (resume extraction only — not used for embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=

# Ollama (embeddings — resumes and jobs both use this)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Redis (single connection URL — used by BullMQ)
REDIS_URL=redis://localhost:6379
